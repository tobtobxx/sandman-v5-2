// Sandman configuration. JSON with comments; trailing commas are allowed.
// Keys left out fall back to the defaults shown here.
{
  // Your name as the model sees it, and the time zone reminders and "today" are computed in.
  "owner": {
    "name": "Human",
    "timezone": "Europe/Zurich"
  },
  // SQLite database. The benchmark always writes its traces to data/bench.db;
  // set this to "data/bench.db" to look at them in the observer.
  "db_path": "data/sandman.db",
  // Files of the "code" role (not implemented in this prototype yet).
  "workspace": "data/workspace",
  "api": {
    "port": 8700,
    // Optional shared secret. When set, API calls need "Authorization: Bearer <token>" or ?token=<token>.
    // The UIs at / and /observer are always served.
    "token": ""
  },
  "web": {
    // SearXNG base URL (e.g. "https://searx.example.org") for live search. Empty: DuckDuckGo HTML, best effort.
    "searxng": ""
  },
  // API key used by every model below that has no "api_key" of its own (an OpenRouter key by default).
  "api_key": "",
  // Which model the different roles use. Use the slugs from the "models" section.
  "roles": {
    // Main model. Does all the work not done by any other model. Required.
    "main": "qwen36-openrouter",
    // Model for directly user-facing calls. Specifying a model here gives the interactive calls a separate queue.
    // Specifying no model (null) makes it use the same as "main".
    "interactive": null,
    // Embeds notes, claims and pending facts for memory search. Required.
    "embedding": "pplx-embed-openrouter",
    // Grades benchmark answers. Only required for bench.
    "judge": "mimo-openrouter"
  },
  // Model endpoints, keyed by a slug of your choice. Any OpenAI-compatible server works (llama.cpp too).
  // Defaults: api_key: "", reasoning_effort: "none", reasoning_tokens: 0, slots: 1, temperature: null,
  // idle_timeout_s: 60.
  "models": {
    "qwen36-openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "model": "qwen/qwen3.6-35b-a3b",
      "api_key": "",
      // "none": reasoning off; "minimal" … "high": sent as the reasoning effort.
      "reasoning_effort": "none",
      // Unless "none": the reasoning budget. llama.cpp cuts reasoning off there (reasoning_budget_tokens);
      // it is also added to each call's max_tokens, which counts reasoning too. 0: no budget.
      "reasoning_tokens": 0,
      // Concurrent calls. On the "main" model also the number of cards worked on at once.
      "slots": 4,
      // null: the provider's default. Retries and a few calls set their own.
      "temperature": 0.3,
      // Abort a streaming call after this many seconds without a token.
      "idle_timeout_s": 60
    },
    "qwen36-local": {
      "base_url": "https://llm.tobtobxx.net/v1",
      "model": "Qwen3.6-35B-A3B:MXFP4_MOE ",
      "reasoning_effort": "none",
      "reasoning_tokens": 0,
      "slots": 1,
      "temperature": null,
      "idle_timeout_s": 120
    },
    "mimo-openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "model": "xiaomi/mimo-v2.6-pro",
      "reasoning_effort": "none",
      "reasoning_tokens": 0,
      "slots": 4,
      "temperature": 0,
      "idle_timeout_s": 90
    },
    "pplx-embed-openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "model": "perplexity/pplx-embed-v1-0.6b",
      // Put before each search text and each stored text. Some models need them (jina: "Query: ", "Document: ").
      "query_prefix": "",
      "document_prefix": "",
      // Cosine similarity a text needs to count as a match by meaning. Model-specific: unrelated texts
      // score about 0.0–0.25 with pplx-embed-v1, related ones 0.3 and up.
      "min_similarity": 0.3,
      "slots": 2,
      "idle_timeout_s": 30
    },
    "jina-embeddings-local": {
      "base_url": "https://llm.tobtobxx.net/v1",
      "model": "jina-embeddings-v5-small-retrieval:Q8_0",
      "query_prefix": "Query: ",
      "document_prefix": "Document: ",
      "min_similarity": 0.3,
      "slots": 4,
      "idle_timeout_s": 30
    }
  }
}